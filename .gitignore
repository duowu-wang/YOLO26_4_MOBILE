# ==============================================================================
# Dataset
#
# Default:
#   DO NOT upload images / labels / masks / dataset contents
#
# Keep:
#   *.yaml
#   *.yml
#   *.md
#
# Both "dataset" and "datasets" are supported.
# ==============================================================================

/dataset/**
/datasets/**

# Allow Git to enter subdirectories
!/dataset/**/
!/datasets/**/

# Keep dataset configuration files
!/dataset/**/*.yaml
!/dataset/**/*.yml
!/datasets/**/*.yaml
!/datasets/**/*.yml

# Keep dataset documentation
!/dataset/**/*.md
!/datasets/**/*.md


# ==============================================================================
# Ultralytics training runs
#
# Ignore everything by default.
# Selected research artifacts are re-included at the END of this file.
# ==============================================================================

/runs/**


# ==============================================================================
# Weights & Biases
# ==============================================================================

wandb/


